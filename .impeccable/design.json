  "narrative": {
    "northStar": "Velocity OD",
    "overview": "Velocity OD pairs the character of a ranch scorebook with the speed of a field instrument. Olive drab carries identity and continuity; warm paper carries records; orange marks the next deliberate action. The compact italic Ropers wordmark sits beside Ranch Horizon, whose aerial image is a fixed part of the identity.\n\nThis document records the implemented shared foundation, Home, and main navigation. Home gives unfinished rounds visual weight and keeps completed records quiet and readable. Scoring, supporting screens, completion effects, and native packaging have their own follow-up scope; inherited styling on those surfaces is not evidence of a newly approved visual pattern.",
    "keyCharacteristics": [
      "Olive drab, warm paper, and purposeful orange.",
      "Compact italic brand typography; sans-serif routine controls.",
      "Large split round-format labels on unfinished rounds.",
      "Flat tonal surfaces and a floating inset navigation dock.",
      "Local font assets and real individual or group round data."
    ],
    "rules": [
      {
        "name": "The Action Color Rule",
        "body": "Reserve orange for the primary action, its directional cue, and visible focus. Olive drab identifies the continuing round and main navigation.",
        "section": "colors"
      },
      {
        "name": "The Functional Type Rule",
        "body": "Use sans-serif for routine controls, navigation, metadata, and archer names. Use Newsreader for identity, round-format display, section headings, and emphasized recent totals.",
        "section": "typography"
      },
      {
        "name": "The Flat Surface Rule",
        "body": "Use tonal contrast, spacing, and fine rules to establish hierarchy. The selected Home and navigation add no shadows.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep the exact frozen ranch aerial in the Ranch Horizon identity asset.",
      "Do preserve the compact italic Ropers wordmark and its quiet sans-serif descriptor.",
      "Do render every unfinished round and every participating archer from stored data; show up to three completed rounds in Recent rounds.",
      "Do keep routine controls in sans-serif, preserve visible focus, and allow enlarged text to reflow the dock.",
      "Do retain real target ring colors independently of interface branding."
    ],
    "donts": [
      "Don't replace the ranch aerial with a generated landscape or remove it through simplification.",
      "Don't treat inherited blue backgrounds, gradients, chart series colors, or older decorative treatments as approved Velocity OD patterns.",
      "Don't apply the Home resume card composition indiscriminately to scoring or supporting screens.",
      "Don't invent scores or round records in production; label component-preview examples as sample content.",
      "Don't add display typography to routine controls or add a dock where setup, import, or active scoring owns the interaction."
    ]
  }
}
