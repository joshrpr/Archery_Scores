  "components": [
    {
      "name": "Start new round",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The full-width primary Home action.",
      "html": "<button class=\"ds-primary\"><span>Start new round</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\" width=\"24\" height=\"24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 5v14M5 12h14\"/></svg></button>",
      "css": ".ds-primary{display:flex;align-items:center;justify-content:space-between;gap:12px;width:100%;min-height:58px;padding:15px 18px;border:0;border-radius:12px;background:var(--arrow,#f2621a);color:var(--ink,#26281f);font:650 17px var(--body,system-ui,sans-serif);cursor:pointer}.ds-primary:hover{background:var(--arrow-hover,#ff873d)}.ds-primary:focus-visible{outline:3px solid var(--arrow-hi,#aa3c0b);outline-offset:3px}"
    },
    {
      "name": "Backup utility",
      "kind": "button",
      "refersTo": "button-utility",
      "description": "A quiet circular Home utility action.",
      "html": "<button class=\"ds-utility\" aria-label=\"Backup and export\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\" width=\"24\" height=\"24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 7h16M4 17h16\"/><circle cx=\"9\" cy=\"7\" r=\"2\"/><circle cx=\"15\" cy=\"17\" r=\"2\"/></svg></button>",
      "css": ".ds-utility{display:grid;place-items:center;width:48px;height:48px;border:0;border-radius:50%;background:transparent;color:var(--od,#4b5320);cursor:pointer}.ds-utility:hover{background:var(--tint,#e6dfcb)}.ds-utility:focus-visible{outline:3px solid var(--arrow-hi,#aa3c0b);outline-offset:3px}"
    },
    {
      "name": "Unfinished round",
      "kind": "card",
      "refersTo": "round-resume",
      "description": "Sample content. Production renders every unfinished round and every participating archer.",
      "html": "<button class=\"ds-resume\" aria-label=\"Sample content: Resume Vegas 300, Alex\"><span class=\"ds-format\">Vegas<span>300</span></span><span class=\"ds-arrow\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\" width=\"24\" height=\"24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 12h15m-6-6 6 6-6 6\"/></svg></span><span class=\"ds-meta\">Sample content · End 4 of 10</span><span class=\"ds-results\"><strong>Alex</strong><span><b>86</b> points &nbsp; 2 X</span></span></button>",
      "css": ".ds-resume{position:relative;display:block;width:100%;padding:24px;border:0;border-radius:16px 16px 54px 16px;background:var(--od,#4b5320);color:var(--paper,#f3eedf);text-align:left;font:17px var(--body,system-ui,sans-serif);cursor:pointer}.ds-format{display:block;padding-right:58px;font:500 58px/.91 var(--display,Newsreader,Georgia,serif);letter-spacing:-.04em}.ds-format>span{display:block;font-size:73px}.ds-arrow{position:absolute;right:20px;top:20px;display:grid;place-items:center;width:48px;height:48px;border-radius:50%;background:var(--arrow,#f2621a);color:var(--ink,#26281f);transform:rotate(-35deg)}.ds-meta{display:block;margin-top:12px;font-size:.78em;line-height:1.5;color:var(--nav-muted,#e3e3c9)}.ds-results{display:flex;flex-wrap:wrap;justify-content:space-between;gap:3px 14px;margin-top:19px;padding-top:14px;border-top:1px solid #bfc69d66;font-size:.84em;font-variant-numeric:tabular-nums}.ds-results strong{font-weight:500}.ds-resume:hover{background:var(--resume-hover,#56602a)}.ds-resume:focus-visible{outline:3px solid var(--arrow-hi,#aa3c0b);outline-offset:4px}"
    },
    {
      "name": "Recent round",
      "kind": "card",
      "refersTo": "round-recent",
      "description": "Sample content. Quiet paper records beneath unfinished rounds.",
      "html": "<button class=\"ds-recent\" aria-label=\"Sample content: View IBO 3D, Alex\"><strong class=\"ds-recent-title\">IBO 3D</strong><span class=\"ds-recent-meta\">Sample content · Oct 28</span><span class=\"ds-recent-result\"><span>Alex</span><span><b>182</b> points &nbsp; 5 11s</span></span></button>",
      "css": ".ds-recent{display:block;width:100%;padding:19px 0;border:0;border-bottom:1px solid var(--rule,#d2ccb9);background:transparent;text-align:left;color:var(--ink,#26281f);font:17px var(--body,system-ui,sans-serif);cursor:pointer}.ds-recent-title{display:block;font-size:.95em;font-weight:650;line-height:1.3}.ds-recent-meta{display:block;margin-top:5px;font-size:.75em;line-height:1.5;color:var(--muted,#65614e)}.ds-recent-result{display:flex;flex-wrap:wrap;justify-content:space-between;gap:3px 14px;margin-top:9px;font-size:.84em;color:var(--muted,#65614e);font-variant-numeric:tabular-nums}.ds-recent-result b{font:500 26px/1 var(--display,Newsreader,Georgia,serif);color:var(--ink,#26281f)}.ds-recent:hover{background:var(--tint,#e6dfcb)}.ds-recent:focus-visible{outline:3px solid var(--arrow-hi,#aa3c0b);outline-offset:3px}"
    },
    {
      "name": "Inset main navigation",
      "kind": "nav",
      "refersTo": "main-navigation",
      "description": "The four destinations; the production layout measures labels and switches to two columns under enlarged text.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Main navigation\"><button aria-current=\"page\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\" width=\"24\" height=\"24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"m3 10 9-7 9 7v10h-6v-6H9v6H3z\"/></svg><span>Home</span></button><button><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\" width=\"24\" height=\"24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 5v5h5M4 10a8 8 0 1 1 0 5m8-9v6l4 2\"/></svg><span>History</span></button><button><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\" width=\"24\" height=\"24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 4v16h17M8 16v-5m5 5V7m5 9v-7\"/></svg><span>Analytics</span></button><button><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\" width=\"24\" height=\"24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"9\" cy=\"8\" r=\"3\"/><path d=\"M3 20v-2a6 6 0 0 1 12 0v2m1-15a3 3 0 0 1 0 6m2 3a5 5 0 0 1 3 4v2\"/></svg><span>Archers</span></button></nav>",
      "css": ".ds-nav{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:4px;padding:8px;border-radius:13px;background:var(--od,#4b5320);color:var(--paper,#f3eedf);font:600 .72rem var(--body,system-ui,sans-serif)}.ds-nav button{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;min-width:0;min-height:48px;padding:5px 3px;border:0;border-radius:6px;background:transparent;color:var(--nav-muted,#e3e3c9);font:inherit;cursor:pointer}.ds-nav svg{width:22px;height:22px;stroke-width:1.6}.ds-nav button[aria-current=page],.ds-nav button:hover{background:var(--nav-active,#626b32);color:var(--paper,#f3eedf)}.ds-nav button:focus-visible{outline:3px solid var(--paper,#f3eedf);outline-offset:-3px}@media(max-width:300px){.ds-nav{grid-template-columns:repeat(2,minmax(0,1fr))}}"
    },
    {
      "name": "Shared text field",
      "kind": "input",
      "refersTo": "field",
      "description": "Readable local form field shared by setup, archer management, import and data tools.",
      "html": "<label class=\"ds-field-label\">Archer name<input class=\"ds-field\" placeholder=\"New archer name\" autocomplete=\"off\"></label>",
      "css": ".ds-field-label{display:block;color:var(--ink,#26281f);font:17px var(--body,system-ui,sans-serif)}.ds-field{display:block;width:100%;min-height:52px;margin-top:8px;padding:10px 14px;border:2px solid var(--rule,#d2ccb9);border-radius:12px;background:var(--tint,#e6dfcb);color:var(--ink,#26281f);caret-color:var(--od,#4b5320);font:1.1em var(--body,system-ui,sans-serif)}.ds-field::placeholder{color:var(--muted,#65614e)}.ds-field:focus-visible{outline:3px solid var(--arrow-hi,#aa3c0b);outline-offset:3px}.ds-field:hover{border-color:var(--rule,#d2ccb9)}"
    },
    {
      "name": "Selected-state color",
      "kind": "chip",
      "refersTo": "chip-selected",
      "description": "Selected picker/filter treatment used throughout setup and supporting workflows.",
      "html": "<button class=\"ds-chip\" aria-pressed=\"true\">Selected</button>",
      "css": ".ds-chip{min-height:52px;padding:10px 16px;border:1px solid var(--od,#4b5320);border-radius:14px;background:var(--od,#4b5320);color:var(--paper,#f3eedf);font:700 1.1rem var(--body,system-ui,sans-serif);cursor:pointer}.ds-chip:hover{background:var(--od,#4b5320)}.ds-chip:focus-visible{outline:3px solid var(--arrow-hi,#aa3c0b);outline-offset:3px}"
    },
    {
      "name": "Vegas score slot",
      "kind": "custom",
      "description": "Labeled arrow slot with a clear next position and correction action.",
      "html": "<div class=\"ds-slot-label\">Arrow 1<button class=\"ds-slot\" aria-label=\"Arrow 1: 10. Tap to clear\">10</button></div>",
      "css": ".ds-slot-label{color:var(--muted,#65614e);font:.72rem system-ui}.ds-slot{display:block;width:100%;min-height:80px;margin-top:7px;padding:14px 5px;border:0;border-radius:12px;background:var(--tint,#e6dfcb);color:var(--ink,#26281f);font:500 2.6rem/1.1 Newsreader,Georgia,serif}.ds-slot:hover{background:var(--sheet,#fcf8ee)}.ds-slot:focus-visible{outline:3px solid var(--arrow-hi,#aa3c0b);outline-offset:3px}"
    },
    {
      "name": "Semantic score badges",
      "kind": "custom",
      "description": "Bright Vegas rings receive dark labels; miss uses paper on the dark data fill.",
      "html": "<div class=\"ds-score-badges\"><b>10</b><b>8</b><b>6</b><b>M</b></div>",
      "css": ".ds-score-badges{display:flex;gap:8px}.ds-score-badges b{padding:6px 10px;border-radius:7px;background:#f5c84c;color:var(--score-ink,#11180d);font:700 1rem system-ui}.ds-score-badges b:nth-child(2){background:#ef5350}.ds-score-badges b:nth-child(3){background:#42a5f5}.ds-score-badges b:nth-child(4){background:#65614e;color:#f3eedf}"
    }
  ],
  "narrative": {
    "northStar": "Velocity OD",
    "overview": "Velocity OD pairs the character of a ranch scorebook with the speed of a field instrument. Olive drab carries identity and continuity; warm paper carries records; orange marks the next deliberate action. The compact italic Ropers wordmark sits beside Ranch Horizon, whose aerial image is a fixed part of the identity.\n\nThis record covers the implemented Home, navigation, individual and group scoring, plotting, scorecards, records, analytics, data tools, completion presentation, and Android delivery. Real saved data drives every production summary and result.",
    "keyCharacteristics": [
      "Olive drab, warm paper, and purposeful orange.",
      "Compact italic brand typography; sans-serif routine controls.",
      "Large split round-format labels on unfinished rounds.",
      "Flat tonal surfaces, readable records, and a floating inset navigation dock.",
      "Local fonts and source-derived Ranch Horizon web and native assets."
    ],
    "rules": [
      {
        "name": "The Action Color Rule",
        "body": "Reserve orange for the next deliberate action, meaningful score feedback, and visible focus; semantic target colors retain their own meanings.",
        "section": "colors"
      },
      {
        "name": "The Functional Type Rule",
        "body": "Use sans-serif for routine controls and dense records; use Newsreader selectively for identity, hierarchy, and emphasized results.",
        "section": "typography"
      },
      {
        "name": "The Flat Surface Rule",
        "body": "Use tonal contrast, spacing, and fine rules for application hierarchy; reserve rendering depth for the target and completion experience.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep the exact frozen ranch aerial and selected crop in every identity export.",
      "Do preserve the compact italic wordmark and selective upright display numerals.",
      "Do derive rounds, participants and results from stored data.",
      "Do preserve keyboard focus, visible focus rings, enlarged-text reflow and safe-area clearance.",
      "Do keep semantic target fills and verify foreground contrast in default, hover and pressed states."
    ],
    "donts": [
      "Don't replace the ranch aerial with generated scenery or an already branded export.",
      "Don't reintroduce decorative navy gradients or change target colors to match the brand.",
      "Don't apply the Home resume-card composition to every supporting record.",
      "Don't hide dense data or remove recovery actions to imitate a prototype.",
      "Don't treat browser or artifact checks as physical Android device observations."
    ]
  }
}
